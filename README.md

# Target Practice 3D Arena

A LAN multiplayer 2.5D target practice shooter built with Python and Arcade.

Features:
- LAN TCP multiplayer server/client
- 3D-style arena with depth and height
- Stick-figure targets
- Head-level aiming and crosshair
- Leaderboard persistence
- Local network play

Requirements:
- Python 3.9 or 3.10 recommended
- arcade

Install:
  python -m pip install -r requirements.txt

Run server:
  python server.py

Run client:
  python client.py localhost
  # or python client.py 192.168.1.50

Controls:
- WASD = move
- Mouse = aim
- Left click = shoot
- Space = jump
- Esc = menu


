#!/usr/bin/env python3
import socket
import json
import threading
import random
import math
import arcade
from enum import Enum


class GameState(Enum):
    MENU = 1
    PLAYING = 2
    LEADERBOARD = 3
    GAME_OVER = 4


class Player:
    def __init__(self, x, y, z):
        self.x = x
        self.y = y
        self.z = z
        self.yaw = 0.0
        self.pitch = 0.0
        self.speed = 8
        self.jump_velocity = 10
        self.vertical_velocity = 0
        self.head_height = 22
        self.score = 0
        self.kills = 0
        self.shots_fired = 0
        self.shots_hit = 0

    def move(self, forward, strafe):
        dx = math.sin(self.yaw) * forward + math.cos(self.yaw) * strafe
        dz = math.cos(self.yaw) * forward - math.sin(self.yaw) * strafe
        self.x += dx * self.speed
        self.z += dz * self.speed

    def jump(self):
        if self.y <= 0.1:
            self.vertical_velocity = self.jump_velocity

    def update_physics(self):
        self.y += self.vertical_velocity
        self.vertical_velocity -= 0.45
        if self.y < 0:
            self.y = 0
            self.vertical_velocity = 0


class Target:
    def __init__(self, x, y, z):
        self.x = x
        self.y = y
        self.z = z
        self.vx = random.uniform(-1.5, 1.5)
        self.vz = random.uniform(-1.5, 1.5)
        self.health = 100

    def update(self, arena_width, arena_depth):
        self.x += self.vx
        self.z += self.vz
        if self.x < 8 or self.x > arena_width - 8:
            self.vx *= -1
        if self.z < 8 or self.z > arena_depth - 8:
            self.vz *= -1
        self.x = max(8, min(arena_width - 8, self.x))
        self.z = max(8, min(arena_depth - 8, self.z))

    def draw(self, screen_x, screen_y, scale):
        head_r = 7 * scale
        body_y = screen_y + 12 * scale
        arcade.draw_circle_filled(screen_x, screen_y, head_r, arcade.RED)
        arcade.draw_line(screen_x, screen_y + head_r, screen_x, body_y, arcade.RED, 2)
        arcade.draw_line(screen_x, body_y, screen_x - 10 * scale, body_y + 16 * scale, arcade.RED, 2)
        arcade.draw_line(screen_x, body_y, screen_x + 10 * scale, body_y + 16 * scale, arcade.RED, 2)
        arcade.draw_line(screen_x, body_y, screen_x - 8 * scale, body_y + 28 * scale, arcade.RED, 2)
        arcade.draw_line(screen_x, body_y, screen_x + 8 * scale, body_y + 28 * scale, arcade.RED, 2)


class Bullet:
    def __init__(self, x, y, z, yaw, pitch):
        self.x = x
        self.y = y
        self.z = z
        self.yaw = yaw
        self.pitch = pitch
        self.speed = 22
        self.life = 120

    def update(self):
        self.x += math.sin(self.yaw) * self.speed * math.cos(self.pitch)
        self.z += math.cos(self.yaw) * self.speed * math.cos(self.pitch)
        self.y += math.sin(self.pitch) * self.speed
        self.life -= 1
        return self.life > 0


class GameClient(arcade.Window):
    def __init__(self, server_ip='localhost', server_port=5000):
        super().__init__(1200, 800, "Target Practice 3D Arena")
        self.server_ip = server_ip
        self.server_port = server_port
        self.socket = None
        self.player_id = None
        self.player_name = ""
        self.input_ip = server_ip
        self.input_name = ""
        self.input_mode = "ip"
        self.game_state = GameState.MENU
        self.leaderboard = []
        self.current_map = 'forest'
        self.arena_width = 220
        self.arena_depth = 220
        self.arena_height = 60
        self.player = Player(self.arena_width / 2, 0, self.arena_depth / 2)
        self.targets = []
        self.bullets = []
        self.keys = set()
        self.game_time = 0
        self.game_duration = 300
        self.game_active = False
        self.cursor_centered = False
        arcade.set_background_color(arcade.color.DARK_SLATE_GRAY)

    def connect_to_server(self):
        try:
            self.socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.socket.settimeout(0.1)
            self.socket.connect((self.input_ip, self.server_port))
            recv = threading.Thread(target=self.receive_messages, daemon=True)
            recv.start()
            return True
        except Exception as exc:
            print(f"Connection failed: {exc}")
            return False

    def send_message(self, message):
        try:
            if self.socket:
                self.socket.send((json.dumps(message) + '\n').encode('utf-8'))
        except Exception:
            pass

    def receive_messages(self):
        buffer = ""
        while True:
            try:
                data = self.socket.recv(4096).decode('utf-8')
                if not data:
                    break
                buffer += data
                while '\n' in buffer:
                    line, buffer = buffer.split('\n', 1)
                    if line:
                        msg = json.loads(line)
                        self.handle_message(msg)
            except socket.timeout:
                continue
            except Exception:
                break

    def handle_message(self, message):
        msg_type = message.get('type')
        if msg_type == 'init':
            self.player_id = message.get('client_id')
        elif msg_type in ('leaderboard_data', 'leaderboard_update'):
            self.leaderboard = message.get('leaderboard', [])

    def spawn_targets(self, count=6):
        self.targets = []
        for _ in range(count):
            self.targets.append(Target(random.randint(20, self.arena_width - 20), 0, random.randint(20, self.arena_depth - 20)))

    def start_game(self):
        self.game_state = GameState.PLAYING
        self.game_active = True
        self.game_time = 0
        self.player.score = 0
        self.player.kills = 0
        self.player.shots_fired = 0
        self.player.shots_hit = 0
        self.spawn_targets()
        self.set_mouse_visible(False)
        self.send_message({'type': 'join_game', 'player_name': self.input_name or 'Player'})

    def project_world_point(self, x, y, z):
        dx = x - self.player.x
        dy = y - self.player.y
        dz = z - self.player.z

        # rotate by camera yaw and pitch relative to player
        cos_y = math.cos(-self.player.yaw)
        sin_y = math.sin(-self.player.yaw)
        tx = dx * cos_y - dz * sin_y
        tz = dx * sin_y + dz * cos_y

        cos_p = math.cos(-self.player.pitch)
        sin_p = math.sin(-self.player.pitch)
        ty = dy * cos_p - tz * sin_p
        dist = dy * sin_p + tz * cos_p

        if dist <= 0.1:
            return None

        scale = 650 / dist
        sx = self.width / 2 + tx * scale
        sy = self.height / 2 - ty * scale
        return sx, sy, scale

    def draw_floor_grid(self):
        step = 20
        for x in range(0, self.arena_width + 1, step):
            for z in range(0, self.arena_depth + 1, step):
                p1 = self.project_world_point(x, 0, z)
                p2 = self.project_world_point(x + step, 0, z)
                p3 = self.project_world_point(x, 0, z + step)
                if p1 and p2:
                    arcade.draw_line(p1[0], p1[1], p2[0], p2[1], arcade.color.DARK_CYAN, 1)
                if p1 and p3:
                    arcade.draw_line(p1[0], p1[1], p3[0], p3[1], arcade.color.DARK_CYAN, 1)

    def draw_targets(self):
        for target in self.targets:
            p = self.project_world_point(target.x, target.y + 22, target.z)
            if p is None:
                continue
            sx, sy, scale = p
            target.draw(sx, sy, scale)

    def draw_player(self):
        cx = self.width / 2
        cy = self.height / 2 + 30
        head_y = cy - 30
        body_y = cy + 10
        arcade.draw_circle_filled(cx, head_y, 12, arcade.color.LIGHT_GREEN)
        arcade.draw_line(cx, head_y + 12, cx, body_y, arcade.color.LIGHT_GREEN, 3)
        arcade.draw_line(cx, body_y, cx - 16, body_y + 20, arcade.color.LIGHT_GREEN, 3)
        arcade.draw_line(cx, body_y, cx + 16, body_y + 20, arcade.color.LIGHT_GREEN, 3)
        arcade.draw_line(cx, body_y, cx - 12, body_y + 52, arcade.color.LIGHT_GREEN, 3)
        arcade.draw_line(cx, body_y, cx + 12, body_y + 52, arcade.color.LIGHT_GREEN, 3)

    def draw_crosshair(self):
        cx = self.width / 2
        cy = self.height / 2
        size = 20
        arcade.draw_line(cx - size, cy, cx + size, cy, arcade.color.GREEN, 2)
        arcade.draw_line(cx, cy - size, cx, cy + size, arcade.color.GREEN, 2)
        arcade.draw_circle_filled(cx, cy, 3, arcade.color.GREEN)

    def draw_hud(self):
        time_left = max(0, self.game_duration - int(self.game_time / 60))
        arcade.draw_text(f"Time: {time_left}s", 20, self.height - 30, 16, arcade.color.WHITE)
        arcade.draw_text(f"Score: {self.player.score}", 20, self.height - 60, 16, arcade.color.GREEN)
        arcade.draw_text(f"Kills: {self.player.kills}", 20, self.height - 90, 16, arcade.color.YELLOW)
        accuracy = (self.player.shots_hit / max(1, self.player.shots_fired)) * 100
        arcade.draw_text(f"Accuracy: {accuracy:.1f}%", 20, self.height - 120, 16, arcade.color.LIGHT_BLUE)
        arcade.draw_text(f"Map: {self.current_map.capitalize()}", self.width - 170, self.height - 30, 16, arcade.color.WHITE)

    def draw_menu(self):
        arcade.draw_rectangle_filled(self.width / 2, self.height / 2, self.width, self.height, arcade.color.BLACK)
        arcade.draw_text("TARGET PRACTICE 3D ARENA", self.width / 2, self.height - 90, 24, arcade.color.GREEN, anchor_x="center", bold=True)
        arcade.draw_text("Server IP:", 140, self.height - 170, 16, arcade.color.WHITE)
        arcade.draw_text(self.input_ip, 140, self.height - 200, 16, arcade.color.GREEN)
        arcade.draw_text("Player Name:", 140, self.height - 260, 16, arcade.color.WHITE)
        arcade.draw_text(self.input_name or "Enter name...", 140, self.height - 290, 16, arcade.color.GREEN)
        arcade.draw_text("WASD move | Mouse aim | Left click shoot | Space jump", self.width / 2, 180, 16, arcade.color.LIGHT_GRAY, anchor_x="center")
        arcade.draw_text("Press ENTER to connect", self.width / 2, 120, 18, arcade.color.GREEN, anchor_x="center")
        arcade.draw_text("Press L for leaderboard", self.width / 2, 80, 16, arcade.color.LIGHT_BLUE, anchor_x="center")

    def draw_leaderboard(self):
        arcade.draw_rectangle_filled(self.width / 2, self.height / 2, self.width, self.height, arcade.color.BLACK)
        arcade.draw_text("LEADERBOARD", self.width / 2, self.height - 60, 22, arcade.color.GREEN, anchor_x="center", bold=True)
        y = self.height - 120
        for i, entry in enumerate(self.leaderboard[:10]):
            name = entry.get('player_name', 'Unknown')
            score = entry.get('score', 0)
            arcade.draw_text(f"#{i + 1} {name}: {score}", 80, y, 16, arcade.color.WHITE)
            y -= 34
        arcade.draw_text("Press M to go back", self.width / 2, 40, 14, arcade.color.LIGHT_GRAY, anchor_x="center")

    def draw_game_over(self):
        arcade.draw_rectangle_filled(self.width / 2, self.height / 2, self.width, self.height, arcade.color.BLACK)
        arcade.draw_text("GAME OVER", self.width / 2, self.height - 100, 22, arcade.color.RED, anchor_x="center", bold=True)
        arcade.draw_text(f"Final Score: {self.player.score}", self.width / 2, self.height - 150, 18, arcade.color.GREEN, anchor_x="center")
        arcade.draw_text(f"Targets Destroyed: {self.player.kills}", self.width / 2, self.height - 200, 16, arcade.color.YELLOW, anchor_x="center")
        accuracy = (self.player.shots_hit / max(1, self.player.shots_fired)) * 100
        arcade.draw_text(f"Accuracy: {accuracy:.1f}%", self.width / 2, self.height - 250, 16, arcade.color.LIGHT_BLUE, anchor_x="center")
        arcade.draw_text("Press ENTER to return to menu", self.width / 2, 70, 14, arcade.color.LIGHT_GRAY, anchor_x="center")

    def on_draw(self):
        arcade.start_render()
        if self.game_state == GameState.MENU:
            self.draw_menu()
        elif self.game_state == GameState.PLAYING:
            self.draw_game()
        elif self.game_state == GameState.LEADERBOARD:
            self.draw_leaderboard()
        elif self.game_state == GameState.GAME_OVER:
            self.draw_game_over()

    def draw_game(self):
        arcade.draw_rectangle_filled(self.width / 2, self.height / 2, self.width, self.height, arcade.color_from_hex('#294F2B'))
        self.draw_floor_grid()
        self.draw_targets()
        self.draw_player()
        self.draw_crosshair()
        self.draw_hud()

    def on_key_press(self, key, modifiers):
        if self.game_state == GameState.MENU:
            if key == arcade.key.RETURN:
                if self.connect_to_server():
                    self.start_game()
            elif key == arcade.key.L:
                self.send_message({'type': 'get_leaderboard'})
                self.game_state = GameState.LEADERBOARD
            elif key == arcade.key.BACKSPACE:
                if self.input_mode == 'ip':
                    self.input_ip = self.input_ip[:-1]
                else:
                    self.input_name = self.input_name[:-1]
            elif key == arcade.key.TAB:
                self.input_mode = 'name' if self.input_mode == 'ip' else 'ip'
            elif self.input_mode == 'ip':
                if key in (arcade.key.PERIOD, arcade.key.MINUS):
                    self.input_ip += '.' if key == arcade.key.PERIOD else '-'
                elif 48 <= key <= 57:
                    self.input_ip += chr(key)
            elif self.input_mode == 'name':
                if 32 <= key <= 126 and len(self.input_name) < 20:
                    self.input_name += chr(key)
            return

        if self.game_state == GameState.PLAYING:
            if key == arcade.key.SPACE:
                self.player.jump()
            if key in (arcade.key.W, arcade.key.A, arcade.key.S, arcade.key.D):
                self.keys.add(key)
            if key == arcade.key.ESCAPE:
                self.game_state = GameState.MENU
                self.set_mouse_visible(True)
            return

        if self.game_state == GameState.LEADERBOARD:
            if key in (arcade.key.M, arcade.key.ESCAPE):
                self.game_state = GameState.MENU
            return

        if self.game_state == GameState.GAME_OVER and key == arcade.key.RETURN:
            self.game_state = GameState.MENU
            self.set_mouse_visible(True)
            self.input_name = ""

    def on_key_release(self, key, modifiers):
        if self.game_state == GameState.PLAYING:
            self.keys.discard(key)

    def on_mouse_motion(self, x, y, dx, dy):
        if self.game_state == GameState.PLAYING:
            center_x = self.width / 2
            center_y = self.height / 2
            mouse_dx = x - center_x
            mouse_dy = y - center_y
            self.player.yaw += mouse_dx * 0.003
            self.player.pitch = max(-1.25, min(1.25, self.player.pitch + mouse_dy * 0.002))
            if not self.cursor_centered:
                self.cursor_centered = True
            arcade.window_commands.set_mouse_position(self.width // 2, self.height // 2)

    def on_mouse_press(self, x, y, button, modifiers):
        if self.game_state == GameState.PLAYING and button == arcade.MOUSE_BUTTON_LEFT:
            self.player.shots_fired += 1
            muzzle_x = self.player.x + math.sin(self.player.yaw) * 10
            muzzle_y = self.player.y + self.player.head_height
            muzzle_z = self.player.z + math.cos(self.player.yaw) * 10
            self.bullets.append(Bullet(muzzle_x, muzzle_y, muzzle_z, self.player.yaw, self.player.pitch))

    def on_update(self, delta_time):
        if self.game_state != GameState.PLAYING or not self.game_active:
            return

        self.game_time += 1
        self.player.update_physics()

        forward = 0.0
        strafe = 0.0
        if arcade.key.W in self.keys:
            forward += 1
        if arcade.key.S in self.keys:
            forward -= 1
        if arcade.key.A in self.keys:
            strafe -= 1
        if arcade.key.D in self.keys:
            strafe += 1
        self.player.move(forward, strafe)
        self.player.x = max(10, min(self.arena_width - 10, self.player.x))
        self.player.z = max(10, min(self.arena_depth - 10, self.player.z))

        for target in self.targets:
            target.update(self.arena_width, self.arena_depth)

        for bullet in list(self.bullets):
            if not bullet.update():
                self.bullets.remove(bullet)
                continue
            for target in list(self.targets):
                dist = math.hypot(bullet.x - target.x, bullet.z - target.z)
                if dist < 12:
                    self.player.score += 10
                    self.player.kills += 1
                    self.player.shots_hit += 1
                    self.targets.remove(target)
                    self.targets.append(Target(random.randint(20, self.arena_width - 20), 0, random.randint(20, self.arena_depth - 20)))
                    self.bullets.remove(bullet)
                    break

        if self.game_time >= self.game_duration * 60:
            self.game_active = False
            self.game_state = GameState.GAME_OVER
            self.send_message({'type': 'update_score', 'player_id': self.player_id, 'score': self.player.score, 'kills': self.player.kills, 'accuracy': (self.player.shots_hit / max(1, self.player.shots_fired)) * 100})
            self.send_message({'type': 'end_game', 'player_id': self.player_id, 'final_score': self.player.score, 'player_name': self.input_name or 'Player'})


if __name__ == '__main__':
    import sys
    ip = sys.argv[1] if len(sys.argv) > 1 else 'localhost'
    GameClient(ip).run()


















































































































































